<Window x:Class="MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MVVM - Розрахунок середньої зарплати" Height="250" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <Label Content="Введіть зарплати працівників (через кому):" FontSize="14"/>
            <TextBox Text="{Binding SalariesInput, UpdateSourceTrigger=PropertyChanged}" 
                     FontSize="14" Margin="0,5,0,10" Padding="4"/>

            <Button Content="Розрахувати" Command="{Binding CalculateCommand}" 
                    Height="30" Margin="0,0,0,15"/>

            <Label Content="Результат:" FontSize="14" FontWeight="Bold"/>
            <TextBlock Text="{Binding AverageSalary, StringFormat='Середня зарплата: {0:F2} грн'}" 
                       FontSize="16" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>